{
  "id": "mamaLocal17",
  "name": "MAMA 17 — Проверить восстановление копии 03:00",
  "nodes": [
    {
      "id": "a5b3d0d2-ea02-488b-af17-65e309539279",
      "name": "По расписанию",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "0ef3bf8c-82dc-4959-8813-9eef5d8e8f6d",
      "name": "Локальный проверенный процесс",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8792/jobs/restore-check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'n8n:' + $workflow.id + ':' + $execution.id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "mamaBridgeLocalOnly",
          "name": "MAMA — локальный мост"
        }
      }
    },
    {
      "id": "0262e3c3-b456-45af-85c0-b06e5d91aa96",
      "name": "Границы доступа",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -290
      ],
      "parameters": {
        "content": "## Только локально\nБаза и переписки не передаются внешним сервисам. Нет публикации кода, списания денег или назначения лечения.\nРабочий процесс по расписанию.",
        "height": 230,
        "width": 500
      }
    },
    {
      "id": "641ef816-029d-4839-bf70-b3d9ec18b92f",
      "name": "Проверка через CLI",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        170
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    }
  ],
  "connections": {
    "По расписанию": {
      "main": [
        [
          {
            "node": "Локальный проверенный процесс",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Проверка через CLI": {
      "main": [
        [
          {
            "node": "Локальный проверенный процесс",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Saratov",
    "errorWorkflow": "mamaLocal18",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "description": "Локальный процесс MAMA с журналом повторов и обработкой ошибок. Сохраняет данные; не вызывает платный ИИ и не публикует изменения."
}