      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8792/jobs/daily-report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'n8n:' + $workflow.id + ':' + $execution.id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "mamaBridgeLocalOnly",
          "name": "MAMA — локальный мост"
        }
      }
    },
    {
      "id": "8cd1f55a-02fc-4ada-8439-cb64cc284b72",
      "name": "Границы доступа",
