      "typeVersion": 1,
      "position": [
        0,
        -290
      ],
      "parameters": {
        "content": "## Только локально\nБаза и переписки не передаются внешним сервисам. Нет публикации кода, списания денег или назначения лечения.\nРабочий процесс по расписанию.",
        "height": 230,
        "width": 500
      }
    },
    {
      "id": "10d9a4c3-3e18-4f7c-821e-228042004bab",
      "name": "Проверка через CLI",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
