{
  "id": "mamaLocal03",
  "name": "MAMA 03 — Ежедневный отчёт 08:00",
  "nodes": [
    {
      "id": "a3704ace-8852-41fd-9a36-0392ef979443",
      "name": "По расписанию",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "ff2bf8a2-3814-4d3c-987b-8601485103a5",
      "name": "Локальный проверенный процесс",
