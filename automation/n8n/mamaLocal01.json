{
  "id": "mamaLocal01",
  "name": "MAMA 01 — Доступность каждые 5 минут",
  "nodes": [
    {
      "id": "d5342027-9f9f-45f1-8414-5e4e7a77640e",
      "name": "По расписанию",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "03530995-517f-4f57-bbfb-dd5781c4249f",
      "name": "Локальный проверенный процесс",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8792/jobs/monitor",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'n8n:' + $workflow.id + ':' + $execution.id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "mamaBridgeLocalOnly",
          "name": "MAMA — локальный мост"
        }
      }
    },
    {
      "id": "80e06ba7-61ca-4eae-88e4-bed68aad9b0e",
      "name": "Границы доступа",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -290
      ],
      "parameters": {
        "content": "## Только локально\nБаза и переписки не передаются внешним сервисам. Нет публикации кода, списания денег или назначения лечения.\nРабочий процесс по расписанию.",
        "height": 230,
        "width": 500
      }
    },
    {
      "id": "6dc815b5-d34b-49ac-ae00-3558639cc710",
      "name": "Проверка через CLI",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        170
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    }
  ],
  "connections": {
    "По расписанию": {
      "main": [
        [
          {
            "node": "Локальный проверенный процесс",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Проверка через CLI": {
      "main": [
        [
          {
            "node": "Локальный проверенный процесс",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Saratov",
    "errorWorkflow": "mamaLocal18",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false,
  "description": "Локальный процесс MAMA с журналом повторов и обработкой ошибок. Сохраняет данные; не вызывает платный ИИ и не публикует изменения."
}