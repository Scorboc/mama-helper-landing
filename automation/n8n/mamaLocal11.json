{
  "id": "mamaLocal11",
  "name": "MAMA 11 — Проверить правила ИИ ежедневно 09:30",
  "nodes": [
    {
      "id": "906b9045-08a3-4f7a-86cb-32d5aca5aebd",
      "name": "По расписанию",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "f815a4ba-7be9-4aec-9676-a65bbb9e5ec0",
      "name": "Локальный проверенный процесс",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8792/jobs/ai-tests",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ 'n8n:' + $workflow.id + ':' + $execution.id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "mamaBridgeLocalOnly",
          "name": "MAMA — локальный мост"
        }
      }
    },
    {
      "id": "46e8aae0-deee-44c4-9947-b34fb8ce2c4e",
      "name": "Границы доступа",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -290
      ],
      "parameters": {
        "content": "## Только локально\nБаза и переписки не передаются внешним сервисам. Нет публикации кода, списания денег или назначения лечения.\nРабочий процесс по расписанию.",
        "height": 230,
        "width": 500
      }
    },
    {
      "id": "8e21bae7-f9c1-468b-95ac-11d1b1f0a333",
      "name": "Проверка через CLI",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        170
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    }
  ],
  "connections": {
    "По расписанию": {
      "main": [
        [
          {
            "node": "Локальный проверенный процесс",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Проверка через CLI": {
      "main": [
        [
          {
            "node": "Локальный проверенный процесс",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Saratov",
    "errorWorkflow": "mamaLocal18",
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all",
    "availableInMCP": true
  },
  "description": "Локальный процесс MAMA с журналом повторов и обработкой ошибок. Сохраняет данные; не вызывает платный ИИ и не публикует изменения.",
  "active": false
