[Unit]
Description=MAMA @NAME@
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mama
Group=mama
WorkingDirectory=/srv/mama/app/backend/parent-app
EnvironmentFile=/etc/mama/@ENV@.env
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/srv/mama/data/n8n
ExecStart=@COMMAND@
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mama/data
MemoryMax=@MEMORY@

[Install]
WantedBy=multi-user.target
