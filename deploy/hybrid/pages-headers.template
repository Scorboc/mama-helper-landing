/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' @API_ORIGIN@; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  Cache-Control: no-cache

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/app-config.json
  ! Cache-Control
  Cache-Control: no-store

/parent-sw.js
  ! Cache-Control
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/cabinet*
  X-Robots-Tag: noindex, nofollow

/account*
  X-Robots-Tag: noindex, nofollow
